#include "cache.h"
#include <iostream>
#include <cmath>
#include <algorithm>

#define SPP_TRACKER_COUNT   64      
#define MAX_PREFETCH_DEGREE 4       
#define MASK_IP 0x3FF   

#define UNI_CONF_MAX  3       
#define UNI_CONF_THRESH 3      

#define LINES_PER_PAGE (1 << (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE)) 
#define SIG_BITS 12
#define SIG_MASK ((1 << SIG_BITS) - 1)

#define PAT_WAYS 8       
#define PAT_MAX 3       
#define PAT_THRESH 1       

#define THROTTLE_SAMPLE_SZ  100     

class SPP_TRACKER {
  public:
    bool     valid;
    uint64_t ip;
    uint64_t last_cl_addr;            
    int8_t   uni_stride;              
    uint8_t  uni_conf;                
    uint16_t sig;                     
    uint8_t  lru;                     

    uint8_t  pat_valid;               
    uint8_t  pat_next;                
    uint16_t pat_sig[PAT_WAYS];       
    int8_t   pat_stride[PAT_WAYS];    
    uint8_t  pat_conf[PAT_WAYS];      

    void initialize(int lru_val) {
        valid = false;
        ip = 0;
        last_cl_addr = 0;
        uni_stride = 0;
        uni_conf = 0;
        sig = 0;
        lru = (uint8_t)lru_val;
        pat_valid = 0;
        pat_next = 0;
        for (int i = 0; i < PAT_WAYS; i++) {
            pat_sig[i] = 0;
            pat_stride[i] = 0;
            pat_conf[i] = 0;
        }
    }
};

SPP_TRACKER trackers[SPP_TRACKER_COUNT];

static uint64_t last_useful_cnt = 0;
static uint64_t last_lower_cnt = 0;
static int current_degree = 3; 
static double latest_accuracy = 0.60;

inline uint16_t next_sig(uint16_t sig, int stride) {
    
    uint16_t enc = (uint16_t)((stride + 32) & 0x3F);
    return (uint16_t)(((sig << 3) ^ enc) & SIG_MASK);
}

inline int pat_find(const SPP_TRACKER &t, uint16_t sig) {
    for (int i = 0; i < PAT_WAYS; i++) {
        if (((t.pat_valid >> i) & 1) && t.pat_sig[i] == sig)
            return i;
    }
    return -1;
}

inline int pat_victim(SPP_TRACKER &t) {
    
    for (int i = 0; i < PAT_WAYS; i++) {
        if (!((t.pat_valid >> i) & 1))
            return i;
    }
    
    for (int i = 0; i < PAT_WAYS; i++) {
        int k = (t.pat_next + i) & (PAT_WAYS - 1);
        if (t.pat_conf[k] == 0) {
            t.pat_next = (k + 1) & (PAT_WAYS - 1);
            return k;
        }
    }
    
    for (int i = 0; i < PAT_WAYS; i++) {
        if (t.pat_conf[i] > 0) t.pat_conf[i]--;
    }
    int k = t.pat_next;
    t.pat_next = (k + 1) & (PAT_WAYS - 1);
    return k;
}

inline void pat_update(SPP_TRACKER &t, uint16_t sig, int stride) {
    int i = pat_find(t, sig);
    if(i >= 0){
        if(t.pat_stride[i] == (int8_t)stride){
            if (t.pat_conf[i] < PAT_MAX) t.pat_conf[i]++;
        } 
        else if(t.pat_conf[i] > 0){
            t.pat_conf[i]--;
        } 
        else{
            t.pat_stride[i] = (int8_t)stride;
        }
        return;
    }
    int idx = pat_victim(t);
    if (idx < 0) return;
    t.pat_valid |= (uint8_t)(1 << idx);
    t.pat_sig[idx] = sig;
    t.pat_stride[idx] = (int8_t)stride;
    t.pat_conf[idx] = 0;
}

inline void update_lru(int idx) {
    for (int i = 0; i < SPP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[idx].lru)
            trackers[i].lru++;
    }
    trackers[idx].lru = 0;
}

inline void check_accuracy_throttling(CACHE *cache) {
    uint64_t cur_useful = cache->pf_useful;
    uint64_t cur_lower = cache->pf_lower_level;

    if (cur_useful < last_useful_cnt || cur_lower < last_lower_cnt) {
        last_useful_cnt = cur_useful;
        last_lower_cnt = cur_lower;
        return;
    }

    uint64_t d_useful = cur_useful - last_useful_cnt;
    uint64_t d_lower = cur_lower - last_lower_cnt;

    if (d_lower >= THROTTLE_SAMPLE_SZ) {
        latest_accuracy = (d_lower > 0) ? ((double)d_useful / (double)d_lower) : 0.0;

        if(latest_accuracy >= 0.80) {
            current_degree = 6;
        }
        else if (latest_accuracy >= 0.60) {
            current_degree = 4;
        } else if (latest_accuracy >= 0.45) {
            current_degree = 3;
        } else if (latest_accuracy >= 0.25) {
            current_degree = 2;
        } else {
            current_degree = 1;
        }

        last_useful_cnt = cur_useful;
        last_lower_cnt  = cur_lower;
    }
}

void CACHE::l1d_prefetcher_initialize()
{
    for (int i = 0; i < SPP_TRACKER_COUNT; i++) {
        trackers[i].initialize(i);
    }
    last_useful_cnt = 0;
    last_lower_cnt = 0;
    current_degree = 3;
    latest_accuracy = 0.60;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit,uint8_t type, uint8_t critical_ip_flag)
{
    
    check_accuracy_throttling(this);
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;
    uint64_t tag_ip  = ip & MASK_IP;

    int index = -1;
    for (int i = 0; i < SPP_TRACKER_COUNT; i++) {
        if (trackers[i].valid && trackers[i].ip == tag_ip) {
            index = i;
            break;
        }
    }

    if (index == -1) {
        for (int i = 0; i < SPP_TRACKER_COUNT; i++) {
            if (!trackers[i].valid) {
                index = i;
                break;
            }
        }
        if (index == -1) {
            for (int i = 0; i < SPP_TRACKER_COUNT; i++) {
                if (trackers[i].lru == (SPP_TRACKER_COUNT - 1)) {
                    index = i;
                    break;
                }
            }
        }
        SPP_TRACKER &t = trackers[index];
        t.valid = true;
        t.ip = tag_ip;
        t.last_cl_addr = cl_addr;
        t.uni_stride = 0;
        t.uni_conf = 0;
        t.sig = 0;
        t.pat_valid = 0;
        t.pat_next = 0;
        update_lru(index);
        return;
    }

    update_lru(index);
    SPP_TRACKER &t = trackers[index];

    int64_t raw_stride = (int64_t)cl_addr - (int64_t)t.last_cl_addr;
    t.last_cl_addr = cl_addr;

    if (raw_stride == 0)return;

    if (raw_stride < -63 || raw_stride > 63) {
        t.uni_conf = 0;
        t.uni_stride = 0;
        t.sig = 0;
        return;
    }

    int stride = (int)raw_stride;
    if(stride == (int)t.uni_stride){
        if(t.uni_conf < UNI_CONF_MAX) t.uni_conf++;
    } 
    else if (t.uni_conf > 0) {
        t.uni_conf--;
    } 
    else {
        t.uni_stride = (int8_t)stride;
        t.uni_conf = 0;
    }

    pat_update(t, t.sig, stride);
    t.sig = next_sig(t.sig, stride);

    if (t.uni_conf >= UNI_CONF_THRESH && t.uni_stride != 0) {
        int eff_degree = (t.uni_conf >= 2) ? current_degree : std::min(current_degree, 2);
        for (int i = 0; i < eff_degree; i++) {
            int64_t delta = (int64_t)t.uni_stride * (i + 1);
            uint64_t pf_address = (uint64_t)((int64_t)cl_addr + delta) << LOG2_BLOCK_SIZE;
            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))break;
            int fill_level = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
            bool ok = prefetch_line(ip, addr, pf_address, fill_level, 0);
            if (!ok) break;
        }
    }

    else {
        uint16_t sig   = t.sig; 
        int64_t  delta = 0;
        for (int i = 0; i < current_degree; i++) {
            int wi = pat_find(t, sig);
            if(wi < 0 || t.pat_conf[wi] < PAT_THRESH || t.pat_stride[wi] == 0)break;

            if(i >= 2 && t.pat_conf[wi] < 2)break;

            int s = (int)t.pat_stride[wi];
            delta += s;

            uint64_t pf_address = (uint64_t)((int64_t)cl_addr + delta) << LOG2_BLOCK_SIZE;

            if((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))break;

            int fill_level = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
            bool ok = prefetch_line(ip, addr, pf_address, fill_level, 0);
            if (!ok) break;

            sig = next_sig(sig, s);
        }
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{

