#include "cache.h"

#define SPP_TRACKER_COUNT 24
#define PREFETCH_DEGREE 3
#define MASK_IP 0xFF

#define UNI_CONF_MAX 2
#define UNI_CONF_THRESH 2

#define LINES_PER_PAGE (1 << (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE))

#define SIG_BITS 12
#define SIG_SHIFT 3
#define SIG_MASK ((1 << SIG_BITS) - 1)

#define PAT_WAYS 8 // no of patterns
#define PAT_MAX 3
#define PAT_THRESH 1

class SPP_TRACKER {
    public:
        bool valid;
        uint64_t ip;
        uint64_t last_page;
        uint64_t last_off;
        int8_t uni_stride;
        uint8_t uni_conf;
        uint16_t sig;
        uint8_t lru;

        uint8_t pat_valid;
        uint8_t pat_next;
        uint16_t pat_sig[PAT_WAYS];
        uint16_t pat_stride[PAT_WAYS];
        uint8_t pat_conf[PAT_WAYS];
        
        void initialize(){
            valid = false;
            ip = 0;
            last_page = 0;
            last_off = 0;
            uni_stride = 0;
            uni_conf = 0;
            sig = 0;
            lru = 0;
            pat_valid = 0;
            pat_next = 0;
            for (int w = 0; w < PAT_WAYS; w++) {
                pat_sig[w] = 0;
                pat_stride[w] = 0;
                pat_conf[w] = 0;
            }
        }
};

SPP_TRACKER trackers[SPP_TRACKER_COUNT];

inline uint16_t next_sig(uint16_t sig, int stride){
    uint16_t stride_modified = (stride < 0)? (uint16_t)((-stride) | 0x40) : (uint16_t) stride;
    return (uint16_t)(((sig << SIG_SHIFT) | stride_modified) & SIG_MASK);
}

inline int pat_find(const SPP_TRACKER &t, uint16_t sig){
    for(int i = 0;i < PAT_WAYS ; i++){
        if(((t.pat_valid >> i) & 1) && t.pat_sig[i] == sig) return i;
    }
    return -1;
}

inline int pat_victim(SPP_TRACKER & t){
    for(int i = 0;i < PAT_WAYS ;i++){
        if(!(t.pat_valid >> i) & 1)return i;
    }
    for(int i = 0;i < PAT_WAYS; i++){
        int k = (t.pat_next + i) & (PAT_WAYS - 1);
        if(t.pat_conf[k] == 0){
            t.pat_next = (k + 1) & (PAT_WAYS - 1);
            return k;
        }
    }
    for(int i = 0;i < PAT_WAYS; i++) t.pat_conf[i]--;
    return -1;
}

inline void inc_tracker(int idx){
    for(int i = 0;i < SPP_TRACKER_COUNT; i++){
        if(trackers[i].lru < trackers[idx].lru)trackers[i].lru++;
    }
    trackers[idx].lru = 0;
}

inline void pat_update(SPP_TRACKER &t,uint8_t sig, int stride){
    int i = pat_find(t, sig);
    if(i>=0) {
        if(t.pat_stride[i] == stride){
            if(t.pat_conf[i] < PAT_MAX)t.pat_conf[i]++;
        }
        else if(t.pat_conf[i]>0)t.pat_conf[i]--;
        else t.pat_stride[i] = (int8_t)stride;
        return ;
    }

    int idx = pat_victim(t);
    if(idx<0)return ;
    t.pat_valid |= (uint8_t)(1<<idx);
    t.pat_sig[idx] = sig;
    t.pat_stride[idx] = stride;
    t.pat_conf[idx] = 0;

}
void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
    for(int i = 0;i<SPP_TRACKER_COUNT;i++) trackers[i].initialize();
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;
    uint64_t page = addr >> LOG2_PAGE_SIZE;
    int offset = (int)(cl_addr * (LINES_PER_PAGE - 1));
    uint16_t page_id  = (uint16_t)((page ^ (page >> 12)) & 0xFFF);

    ip = ip & MASK_IP;
    int idx = 0;
    for (; idx<SPP_TRACKER_COUNT; idx++) {
        if (trackers[idx].ip == ip)break;
    }

    if(idx == SPP_TRACKER_COUNT){
        for(idx = 0;idx < SPP_TRACKER_COUNT; idx++) if(trackers[idx].lru == SPP_TRACKER_COUNT - 1)break;
        SPP_TRACKER &t = trackers[idx];
        t.valid = true;
        t.ip = ip;
        t.last_page = page_id;
        t.last_off = (uint8_t)offset;
        t.uni_stride = 0;
        t.uni_conf = 0;
        t.sig = 0;
        t.lru = 0;
        t.pat_valid = 0;
        t.pat_next = 0;
        inc_tracker(idx);
        return ;
    }

    inc_tracker(idx);
    SPP_TRACKER &t = trackers[idx];
    int stride = 0;
    bool f = 1;
    if(t.last_page == page_id)stride = offset-(int)t.last_off;
    else{
        int fwd = offset + LINES_PER_PAGE - (int)t.last_off;  
        int bwd = offset - LINES_PER_PAGE - (int)t.last_off;  

        if(fwd < LINES_PER_PAGE)stride = fwd;
        else if(bwd > -LINES_PER_PAGE) stride = bwd;
        else{ 
            stride = 0; 
            f = false; 
        }
    }

    if(f){
        if(stride == 0)return ;
        if(stride == t.uni_stride){
            if(t.uni_conf<UNI_CONF_MAX)t.uni_conf++;
        }
        else if(t.uni_conf>UNI_CONF_THRESH)t.uni_conf--;
        else{
            t.uni_stride = (int8_t)stride;
            t.uni_conf = 0;
        }
        pat_update(t, t.sig, stride);
        t.sig = next_sig(t.sig, stride);
    }
    t.last_page = page_id;
    t.last_off = (uint8_t)offset;

    if(t.uni_conf>=UNI_CONF_THRESH && t.uni_stride!=0){
        for (int i=0; i<PREFETCH_DEGREE; i++) {
            uint64_t pf_address = (cl_addr + (stride*(i+1))) << LOG2_BLOCK_SIZE;

            // only issue a prefetch if the prefetch address is in the same 4 KB page
            // as the current demand access address
            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                break;

            // check the MSHR occupancy to decide if we're going to prefetch to the L1 or L2
            bool f = 0;
            if (MSHR.occupancy < (MSHR.SIZE>>1))
              f=prefetch_line(ip, addr, pf_address, FILL_L1, 0);
            else
              f=prefetch_line(ip, addr, pf_address, FILL_L2, 0);
            if(!f)break;
        }
    }
    else{
        uint16_t sig = t.sig;
        int off = offset;
        for (int i=0; i<PREFETCH_DEGREE; i++) {
            int idx = pat_find(t,sig);
            if(idx < 0 || t.pat_conf[idx]<PAT_THRESH || t.pat_stride[idx] == 0)break;
            int stride1 = t.pat_stride[idx];
            off+=stride1; 
            uint64_t pf_address = (cl_addr + off) << LOG2_BLOCK_SIZE;

            // only issue a prefetch if the prefetch address is in the same 4 KB page
            // as the current demand access address
            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                break;

            // check the MSHR occupancy to decide if we're going to prefetch to the L1 or L2
            bool f = 0;
            if (MSHR.occupancy < (MSHR.SIZE>>1))
              f=prefetch_line(ip, addr, pf_address, FILL_L1, 0);
            else
              f=prefetch_line(ip, addr, pf_address, FILL_L2, 0);
            if(!f)break;
            sig = next_sig(sig,stride1);
        }
    }


}

